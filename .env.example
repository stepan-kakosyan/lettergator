# Core Django settings
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
TIME_ZONE=UTC

# Database (adjust for your environment)
DB_NAME=lettergator
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Lemon Squeezy top-up settings
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=

# Optional override
# LEMONSQUEEZY_API_BASE=https://api.lemonsqueezy.com

# Media files
MEDIA_URL=/media/

# AWS S3 media storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Optional: custom CDN or bucket domain (for example d111111abcdef8.cloudfront.net)
AWS_S3_CUSTOM_DOMAIN=

# Email backend
# For SMTP (default): keep EMAIL_BACKEND unset
# For AWS SES via django-ses: set EMAIL_BACKEND=django_ses.SESBackend
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=no-reply@example.com

# AWS SES (optional, only when EMAIL_BACKEND=django_ses.SESBackend)
AWS_SES_REGION_NAME=
AWS_SES_REGION_ENDPOINT=
# Leave empty to disable quota checks (avoids requiring ses:GetSendQuota)
AWS_SES_AUTO_THROTTLE=

# Physical letter pricing extras
# These are used in addition to country pricing from admin.
PHYSICAL_LETTER_EXTRA_PHOTO_PRICE_USD=1.00
PHYSICAL_LETTER_EXTRA_PAGE_PRICE_USD=0.50
PHYSICAL_LETTER_EXTRA_YEAR_PRICE_USD=0.50
PHYSICAL_LETTER_MAX_DELIVERY_YEARS=10
PHYSICAL_LETTER_MAX_TEXT_FILES=3
PHYSICAL_LETTER_MAX_PHOTO_FILES=3
PHYSICAL_LETTER_MAX_FILE_SIZE_MB=10
PHYSICAL_LETTER_TEXT_CHARS_PER_PAGE=1800
