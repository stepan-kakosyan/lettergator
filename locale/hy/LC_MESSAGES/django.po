msgstr "Այսօրվանից <strong>1 տարի կամ ավելի</strong> ժամկետով առաքվող նամակները արժեն <strong>$0.50 տարեկան</strong>։"

msgid ""
"Letters delivered <strong>under 1 year</strong> from today are "
